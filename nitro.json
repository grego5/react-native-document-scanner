{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "documentscanner"
  ],
  "ios": {
    "iosModuleName": "ReactNativeDocumentScanner"
  },
  "android": {
    "androidNamespace": [
      "documentscanner"
    ],
    "androidCxxLibName": "ReactNativeDocumentScanner"
  },
  "autolinking": {
    "DocumentScannerCameraView": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridDocumentScannerCameraView"
      },
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridDocumentScannerCameraView"
      }
    },
    "ScanSession": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridScanSession"
      },
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridScanSession"
      }
    },
    "DocumentScannerProcessor": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridDocumentScannerProcessor"
      },
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridDocumentScannerProcessor"
      }
    },
    "DocumentCropEditorView": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridDocumentCropEditorView"
      },
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridDocumentCropEditorView"
      }
    },
    "PageThumbnailView": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPageThumbnailView"
      },
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridPageThumbnailView"
      }
    },
    "ImageViewerView": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridImageViewerView"
      },
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridImageViewerView"
      }
    },
    "ImagePagerView": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridImagePagerView"
      },
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridImagePagerView"
      }
    },
    "CameraPermission": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridCameraPermission"
      },
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridCameraPermission"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules",
    "lib",
    "archive"
  ]
}
